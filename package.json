{
  "name": "marketplace-app-boilerplate",
  "version": "2.0.6",
  "private": true,
  "files": [
    "dist"
  ],
  "dependencies": {
    "@contentstack/app-sdk": "^2.3.4",
    "@contentstack/management": "^1.25.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "axios": "^1.13.5",
    "form-data": "^4.0.4",
    "html-react-parser": "^3.0.8",
    "jsonfile": "^6.1.0",
    "jsrsasign": "^11.1.1",
    "lodash": "^4.18.1",
    "node-forge": "^1.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.5",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "build:check": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:chrome": "npx playwright test --config=playwright.config.ts --project=Chromium",
    "test:firefox": "npx playwright test --config=playwright.config.ts --project=firefox",
    "test:chrome-headed": "npx playwright test --headed --config=playwright.config.ts --project=Chromium",
    "test:firefox-headed": "npx playwright test --headed --config=playwright.config.ts --project=firefox",
    "test:report": "npx playwright test && npx playwright show-report",
    "test:report-ci": "npx playwright test --reporter=html,json,junit",
    "report:show": "npx playwright show-report",
    "report:generate": "./scripts/generate-report.sh"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@eslint-react/eslint-plugin": "^5.30.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.23.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsrsasign": "^10.5.15",
    "@types/lodash": "^4.14.202",
    "@types/node-forge": "^1.3.11",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.12",
    "dotenv": "^16.4.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.23.1",
    "prettier": "^2.7.1",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.2.3",
    "vitest": "^4.1.12"
  }
}
